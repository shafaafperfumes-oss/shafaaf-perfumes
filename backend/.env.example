# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values there.
# `.env` is git-ignored and must NEVER be committed or shared.
# This file holds placeholders only — no real secrets.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Requests allowed per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase dashboard -> Connect -> ORMs / Session pooler.
# These strings contain your database password: they belong in `.env`
# only — never in frontend code, a screenshot, or a chat message.
# Leave them blank and the API still starts; it simply reports the
# database as "not-configured" on /api/v1/ready.
#
# DATABASE_URL  — pooled connection (port 6543, pgbouncer=true), used by
#                 the running API for everyday queries.
# DIRECT_URL    — direct/session connection (port 5432), used only when
#                 running `npm run db:migrate`. Falls back to
#                 DATABASE_URL if not set.
# ---------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------
# Added in later phases — listed here so nobody is tempted to put
# them in frontend code. Keep them blank until that phase starts.
# ---------------------------------------------------------------

# Phase 4 — Supabase Auth
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=           # safe for the browser
# SUPABASE_SERVICE_ROLE_KEY=   # SERVER ONLY. Bypasses all database rules.

# Phase 7 — Razorpay payments
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=         # SERVER ONLY
# RAZORPAY_WEBHOOK_SECRET=     # SERVER ONLY
