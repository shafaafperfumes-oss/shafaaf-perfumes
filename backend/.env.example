# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values there.
# `.env` is git-ignored and must NEVER be committed or shared.
# This file holds placeholders only — no real secrets.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Requests allowed per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase dashboard -> Connect -> ORMs / Session pooler.
# These strings contain your database password: they belong in `.env`
# only — never in frontend code, a screenshot, or a chat message.
# Leave them blank and the API still starts; it simply reports the
# database as "not-configured" on /api/v1/ready.
#
# DATABASE_URL  — pooled connection (port 6543, pgbouncer=true), used by
#                 the running API for everyday queries.
# DIRECT_URL    — direct/session connection (port 5432), used only when
#                 running `npm run db:migrate`. Falls back to
#                 DATABASE_URL if not set.
# ---------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------
# Sign-in (Supabase Auth)
# Supabase dashboard -> Project Settings -> API.
# Setup guide: docs/SUPABASE-AUTH-SETUP.md
#
# SUPABASE_URL               — not a secret; the project's own URL.
# SUPABASE_SERVICE_ROLE_KEY  — SERVER ONLY. Bypasses every database rule.
#                               Never sent to a browser, never logged.
# Leave both blank and the API still starts; sign-in routes simply
# report themselves as unavailable on /api/v1/ready and to callers.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Payments (Razorpay)
# Setup guide: docs/RAZORPAY-SETUP.md
#
# RAZORPAY_KEY_ID         — not a secret; the browser's Razorpay Checkout
#                            widget uses this same value.
# RAZORPAY_KEY_SECRET     — SERVER ONLY. Signs API calls to Razorpay.
# RAZORPAY_WEBHOOK_SECRET — SERVER ONLY. A separate secret from the
#                            dashboard's webhook page, not the API keys page.
# Leave all three blank and the API still starts; checkout still places
# orders, it just cannot create a payment for one yet.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Email (Resend)
# Setup guide: docs/EMAIL-SETUP.md
#
# RESEND_API_KEY    — SERVER ONLY. From resend.com -> API Keys.
# EMAIL_FROM        — not a secret. Leave blank to use Resend's shared
#                      onboarding address (delivers only to the Resend
#                      account's own inbox — fine for owner alerts). Once
#                      the shop's domain is verified in Resend, set e.g.
#                      "Shafaaf Perfumes <orders@shafaafperfumes.com>".
# ORDER_ALERT_EMAIL — not a secret. Where "new paid order" alerts go.
# Leave all blank and the API still starts; it simply sends no email.
# ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
ORDER_ALERT_EMAIL=

# ---------------------------------------------------------------
# Added in later phases — listed here so nobody is tempted to put
# them in frontend code. Keep them blank until that phase starts.
# ---------------------------------------------------------------
