{
  "name": "shafaaf-perfumes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Shafaaf Perfumes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:import:inspired": "tsx src/db/import-inspired.ts",
    "content:import": "tsx src/db/import-content.ts",
    "analytics:export": "tsx src/db/export-analytics.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sharp": "^0.34.5",
    "zod": "^4.1.13"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
