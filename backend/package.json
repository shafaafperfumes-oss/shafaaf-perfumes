{
  "name": "shafaaf-perfumes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Shafaaf Perfumes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
