# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
service-account*.json

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-error.log*

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Local tooling ---
.cache/
.temp/
tmp/
.vscode/
.idea/

# --- Original, uncompressed photographs ---
# Kept on the owner's computer as a master copy. They are far too large to
# serve to customers, so only the compressed versions are committed.
images/_originals/

# --- OS noise ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Wrangler local state (npx wrangler dev)
.wrangler/
